# === Frontend (Vite) ===
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# === QA smoke tests (GitHub Actions secrets/variables, never commit real passwords) ===
PIXELRISES_SMOKE_EMAIL=qa@example.com
PIXELRISES_SMOKE_PASSWORD=rotate_this_in_github_secrets
PIXELRISES_GENERATOR_REAL_QA=0
PIXELRISES_GENERATOR_DAILY_REAL_BUDGET=3
PIXELRISES_SMOKE_ONLY=

# === Backend (Supabase Edge Functions) ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ADMIN_ALLOWED_EMAILS=your-google-email@example.com

# === AI ===
# Preferred provider for secure backend / edge functions only.
# Vercel AI Gateway is recommended for Pixelrises Multi-IA in production.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
AI_GATEWAY_MODEL=openai/gpt-4o-mini
AI_GATEWAY_FAST_MODEL=mistral/mistral-small
AI_GATEWAY_CHEAP_MODEL=mistral/ministral-8b
AI_GATEWAY_BALANCED_MODEL=meta/llama-3.3-70b
AI_GATEWAY_REASONING_MODEL=anthropic/claude-3.5-haiku
AI_GATEWAY_OPENAI_MODEL=openai/gpt-4o-mini
AI_GATEWAY_CLAUDE_MODEL=anthropic/claude-3.5-haiku
AI_GATEWAY_DESIGN_MODEL=mistral/pixtral-12b
AI_GATEWAY_DESIGN_PREMIUM_MODEL=mistral/pixtral-large
AI_GATEWAY_WOW_MODEL=openai/gpt-4o
AI_GATEWAY_PREMIUM_MODEL=anthropic/claude-opus-4.5
AI_GATEWAY_CODE_MODEL=mistral/codestral
AI_GATEWAY_SAFETY_MODEL=openai/gpt-oss-safeguard-20b
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_GATEWAY_DEEP_RESEARCH_MODEL=openai/o3-deep-research
AI_GATEWAY_FALLBACK_MODELS=openai/gpt-4o-mini,mistral/mistral-small,meta/llama-3.3-70b,anthropic/claude-3.5-haiku
GEMINI_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_key_here
CLAUDE_API_KEY=your_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest
MISTRAL_API_KEY=your_key_here
# Optional: set to vercel-gateway, openai, claude, gemini, or leave empty for auto-detection.
AI_DEFAULT_PROVIDER=vercel-gateway
AI_ENABLE_MOCK=true
AI_ENABLE_MULTI_PROVIDER=false
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=45000
AI_LOG_LEVEL=info
AI_DAILY_BUDGET_EUR=
AI_MAX_COST_PER_REQUEST_EUR=
AI_COST_GUARD_ENABLED=false
# Optional fallback provider used by the legacy Lovable AI gateway
LOVABLE_API_KEY=your_key_here

# === Stripe ===
STRIPE_SECRET_KEY=your_key_here
STRIPE_WEBHOOK_SECRET=your_key_here

