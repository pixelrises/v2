# === Frontend (Vite) ===
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# === Backend (Supabase Edge Functions) ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ADMIN_ALLOWED_EMAILS=your-google-email@example.com

# === AI ===
# Preferred provider for secure backend / edge functions only.
# Vercel AI Gateway is recommended for Pixelrises Multi-IA in production.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
AI_GATEWAY_FAST_MODEL=google/gemini-3.1-flash-lite-preview
AI_GATEWAY_BALANCED_MODEL=google/gemini-3-flash
AI_GATEWAY_REASONING_MODEL=anthropic/claude-sonnet-4.6
AI_GATEWAY_WOW_MODEL=openai/gpt-5.5
AI_GATEWAY_PREMIUM_MODEL=anthropic/claude-opus-4.7
AI_GATEWAY_CODE_MODEL=deepseek/deepseek-v3.1-terminus
AI_GATEWAY_EMBEDDING_MODEL=google/gemini-embedding-2
AI_GATEWAY_FALLBACK_MODELS=google/gemini-3-flash,anthropic/claude-haiku-4.5,deepseek/deepseek-v3.1-terminus,mistral/mistral-medium
GEMINI_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=your_key_here
CLAUDE_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-5
MISTRAL_API_KEY=your_key_here
# Optional: set to vercel-gateway, openai, claude, gemini, or leave empty for auto-detection.
AI_DEFAULT_PROVIDER=vercel-gateway
AI_ENABLE_MOCK=true
AI_ENABLE_MULTI_PROVIDER=false
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=45000
AI_LOG_LEVEL=info
AI_DAILY_BUDGET_EUR=
AI_MAX_COST_PER_REQUEST_EUR=
AI_COST_GUARD_ENABLED=false
# Optional fallback provider used by the legacy Lovable AI gateway
LOVABLE_API_KEY=your_key_here

# === Stripe ===
STRIPE_SECRET_KEY=your_key_here
STRIPE_WEBHOOK_SECRET=your_key_here

